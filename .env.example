# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mealora"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRY="7d"

# Session
SESSION_SECRET="your-session-secret-change-in-production"

# Server
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:3000"

# Email (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
MAIL_FROM="noreply@mealora.com"

# Maps (optional - use free tier for development)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-key"

# File Storage
NEXT_PUBLIC_STORAGE_URL="http://localhost:5000/uploads"
FILE_UPLOAD_PATH="./uploads"
MAX_FILE_SIZE="5242880"

# Features
ENABLE_EMAIL_VERIFICATION="false"
ENABLE_PHONE_VERIFICATION="false"
ENABLE_EMERGENCY_ALERTS="true"

# Admin
DEFAULT_ADMIN_EMAIL="admin@mealora.com"
DEFAULT_ADMIN_PASSWORD="change-in-production"
